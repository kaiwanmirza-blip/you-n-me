{
  "name": "you-n-me",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 127.0.0.1",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "build": "node node_modules/vite/bin/vite.js build && node node_modules/typescript/bin/tsc -p tsconfig.api.json",
    "preview": "node node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "dev:api": "node node_modules/tsx/dist/cli.mjs watch server/index.ts",
    "start:api": "node dist-api/server/index.js",
    "build:web": "node node_modules/vite/bin/vite.js build",
    "build:api": "node node_modules/typescript/bin/tsc -p tsconfig.api.json",
    "start": "node dist-api/server/preview.js"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
