{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"],
    "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "skipLibCheck": true,
    "outDir": "dist-api", "rootDir": ".",
    "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"],
  "exclude": ["**/*.test.ts"]
}
